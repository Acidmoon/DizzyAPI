{
  "name": "dizzyapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "description": "DizzyAPI · 以 cordis 为编排层、Go 为数据面的模型网关",
  "scripts": {
    "start": "cordis run",
    "predev": "pnpm build:go",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--import tsx --import @cordisjs/unyaml\" node --expose-internals node_modules/cordis/bin.js run",
    "build:go": "node -e \"require('node:fs').mkdirSync('bin',{recursive:true})\" && go build -trimpath -o bin/ ./cmd/gatewayd",
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
    "test:go": "go test ./...",
    "test:all": "pnpm test && pnpm test:go",
    "preview:console": "node --import tsx packages/console/src/preview-main.ts",
    "preview:deepseek-usage": "node --import tsx packages/deepseek-usage/src/preview-main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/console/tsconfig.json"
  },
  "dependencies": {
    "@cordisjs/plugin-cli": "^1.1.2",
    "@cordisjs/plugin-cli-cordis": "^1.0.5",
    "@cordisjs/plugin-env": "^1.0.1",
    "@cordisjs/plugin-group": "^1.0.0",
    "@cordisjs/plugin-hmr": "^1.0.15",
    "@cordisjs/plugin-include": "^1.1.1",
    "@cordisjs/plugin-loader": "^1.0.0-rc.8",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "@cordisjs/plugin-timer": "^1.1.4",
    "@dizzyapi/plugin-account-admin": "workspace:*",
    "@dizzyapi/plugin-account-health": "workspace:*",
    "@dizzyapi/plugin-account-priority": "workspace:*",
    "@dizzyapi/plugin-admin": "workspace:*",
    "@dizzyapi/plugin-api": "workspace:*",
    "@dizzyapi/plugin-api-key": "workspace:*",
    "@dizzyapi/plugin-auth": "workspace:*",
    "@dizzyapi/plugin-billing": "workspace:*",
    "@dizzyapi/plugin-catalog": "workspace:*",
    "@dizzyapi/plugin-credentials": "workspace:*",
    "@dizzyapi/plugin-deepseek-usage": "workspace:*",
    "@dizzyapi/plugin-font-smiley": "workspace:*",
    "@dizzyapi/plugin-frontend": "workspace:*",
    "@dizzyapi/plugin-identity": "workspace:*",
    "@dizzyapi/plugin-kit": "workspace:*",
    "@dizzyapi/plugin-mailer": "workspace:*",
    "@dizzyapi/plugin-page-template": "workspace:*",
    "@dizzyapi/plugin-pricing": "workspace:*",
    "@dizzyapi/plugin-quota": "workspace:*",
    "@dizzyapi/plugin-redeem": "workspace:*",
    "@dizzyapi/plugin-settings": "workspace:*",
    "@dizzyapi/plugin-topup": "workspace:*",
    "@dizzyapi/plugin-usage": "workspace:*",
    "@dizzyapi/plugin-user": "workspace:*",
    "@dizzyapi/plugin-web": "workspace:*",
    "cordis": "^4.0.0-rc.11"
  },
  "devDependencies": {
    "@cordisjs/unyaml": "^2.0.3",
    "@types/node": "^25.3.5",
    "cross-env": "^10.1.0",
    "tsx": "npm:@cordiverse/tsx@4.19.3-fix.3",
    "typescript": "^5.9.3"
  }
}
